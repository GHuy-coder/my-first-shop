<div class="mini-home" id="mini-home-{{ section.id }}">
  <header class="site-header">
    <div class="utility-bar"><div class="header-wrap"><div class="utility-links"><span>{{ section.settings.hotline | escape }}</span><i></i><span>{{ section.settings.delivery_note | escape }}</span><i></i><span>{{ section.settings.store_note | escape }}</span></div><a href="{{ routes.account_url }}">Đăng nhập / Đăng ký</a></div></div>
    <div class="main-header"><div class="header-wrap main-header-inner">
      <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} trang chủ">{{ section.settings.brand_text | escape }}</a>
      <form class="search" action="{{ routes.search_url }}" method="get" role="search"><select aria-label="Danh mục"><option value="">Tất cả danh mục</option>{% for collection in section.settings.categories %}<option value="{{ collection.title | escape }}">{{ collection.title | escape }}</option>{% endfor %}</select><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Tìm kiếm sản phẩm, thương hiệu, danh mục..." aria-label="Tìm kiếm sản phẩm"><input type="hidden" name="type" value="product"><button type="submit" aria-label="Tìm kiếm">⌕</button></form>
      <a class="support-pill" href="tel:{{ section.settings.phone_link | escape }}">♬ Tư vấn mua hàng: {{ section.settings.hotline | escape }}</a>
      <a class="cart-button" href="{{ routes.cart_url }}">🛒 Giỏ hàng (<span>{{ cart.item_count }}</span>)</a>
      <a class="account" href="{{ routes.account_url }}"><span class="avatar">{{ shop.name | slice: 0 | upcase }}</span><span>Xin chào,<br><strong>{{ customer.first_name | default: 'bạn' | escape }}</strong></span></a>
    </div></div>
    <nav class="main-nav"><div class="header-wrap"><a class="all-categories" href="#mini-categories-{{ section.id }}">☰ Danh mục sản phẩm</a><a href="{{ routes.root_url }}">Trang chủ</a><div class="category-nav">{% for collection in section.settings.categories limit: 4 %}<a href="{{ collection.url }}">{{ collection.title | escape }}</a>{% endfor %}</div><a href="#mini-flash-{{ section.id }}">Flash Sale 🔥</a><a href="#mini-featured-{{ section.id }}">Khuyến mãi hot</a></div></nav>
  </header>
  <main class="wrap">
    <section class="benefits" aria-label="Chính sách mua hàng"><div class="benefit"><span class="benefit-icon">✿</span><div><strong>{{ section.settings.benefit_1_title | escape }}</strong><small>{{ section.settings.benefit_1_text | escape }}</small></div></div><div class="benefit"><span class="benefit-icon">⟳</span><div><strong>{{ section.settings.benefit_2_title | escape }}</strong><small>{{ section.settings.benefit_2_text | escape }}</small></div></div><div class="benefit"><span class="benefit-icon">⚡</span><div><strong>{{ section.settings.benefit_3_title | escape }}</strong><small>{{ section.settings.benefit_3_text | escape }}</small></div></div><div class="benefit"><span class="benefit-icon">◉</span><div><strong>{{ section.settings.benefit_4_title | escape }}</strong><small>{{ section.settings.benefit_4_text | escape }}</small></div></div></section>
    <section class="hero-grid" aria-label="Ảnh giới thiệu"><article class="hero mini-slider" aria-roledescription="carousel"><div class="hero-slides" aria-live="polite">{% assign slide_count = 0 %}{% for block in section.blocks %}{% if block.type == 'slide' and block.settings.image != blank %}{% assign slide_count = slide_count | plus: 1 %}<figure class="hero-slide{% if slide_count == 1 %} active{% endif %}" {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.caption }}</a>{% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}</figure>{% endif %}{% endfor %}{% if slide_count == 0 %}<figure class="hero-slide active"><a href="{{ routes.all_products_collection_url }}"><img src="{{ 'photo-1516035069371-29a1b244cc32.jpg' | asset_url }}" alt="Khám phá sản phẩm MiniShop" loading="eager" width="1600" height="900"></a><figcaption>Khám phá sản phẩm được chọn lọc tại MiniShop</figcaption></figure><figure class="hero-slide"><a href="{{ routes.all_products_collection_url }}"><img src="{{ 'photo-1496181133206-80ce9b88a853.jpg' | asset_url }}" alt="Ưu đãi hấp dẫn mỗi ngày" loading="lazy" width="1600" height="900"></a><figcaption>Ưu đãi hấp dẫn mỗi ngày tại MiniShop</figcaption></figure>{% assign slide_count = 2 %}{% endif %}</div><div class="slide-controls" {% if slide_count < 2 %}hidden{% endif %}><button type="button" class="slide-arrow previous" aria-label="Ảnh trước">‹</button><div class="slide-dots" aria-label="Chọn ảnh"></div><button type="button" class="slide-arrow next" aria-label="Ảnh tiếp theo">›</button></div></article>
      <div class="promos">{% assign promo_index = 0 %}{% for block in section.blocks %}{% if block.type == 'promo' %}{% assign promo_index = promo_index | plus: 1 %}<article class="promo" {% if block.settings.image != blank %}style="--promo-image:url('{{ block.settings.image | image_url: width: 900 }}')"{% elsif promo_index == 1 %}style="--promo-image:url('{{ 'photo-1442512595331-e89e73853f31.jpg' | asset_url }}')"{% else %}style="--promo-image:url('{{ 'photo-1556911220-e15b29be8c8f.jpg' | asset_url }}')"{% endif %} {{ block.shopify_attributes }}><label>{{ block.settings.label | escape }}</label><h3>{{ block.settings.heading | escape }}</h3><strong>{{ block.settings.offer | escape }}</strong><a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.link_label | escape }} ›</a></article>{% endif %}{% endfor %}{% if promo_index == 0 %}<article class="promo" style="--promo-image:url('{{ 'photo-1442512595331-e89e73853f31.jpg' | asset_url }}')"><label>Cà phê thượng hạng</label><h3>Ưu đãi cà phê nguyên chất</h3><strong>MUA 2 TẶNG 1</strong><a href="{{ routes.all_products_collection_url }}">Khám phá ngay ›</a></article><article class="promo" style="--promo-image:url('{{ 'photo-1556911220-e15b29be8c8f.jpg' | asset_url }}')"><label>Nhà cửa &amp; đời sống</label><h3>Đồ gia dụng thông minh</h3><strong>VOUCHER 50.000₫</strong><a href="#mini-categories-{{ section.id }}">Nhận mã giảm giá ›</a></article>{% endif %}</div>
    </section>
    <section class="section" id="mini-categories-{{ section.id }}"><div class="section-head"><h2>{{ section.settings.categories_heading | escape }}</h2><a class="more-link" href="{{ routes.collections_url }}">Xem tất cả danh mục ›</a></div><div class="categories">{% if section.settings.categories != blank %}{% for collection in section.settings.categories %}<a class="category" href="{{ collection.url }}">{% if collection.image %}{{ collection.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: collection.title }}{% elsif collection.products.first.featured_image %}{{ collection.products.first.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}<strong>{{ collection.title | escape }}</strong><small>{{ collection.products_count }}+ sản phẩm</small></a>{% endfor %}{% else %}{% assign category_names = 'Cà phê & Đồ uống|Gia dụng tiện ích|Trang trí nhà cửa|Phụ kiện công nghệ|Cây cảnh để bàn|Văn phòng phẩm' | split: '|' %}{% assign category_images = 'photo-1442512595331-e89e73853f31.jpg|photo-1556911220-e15b29be8c8f.jpg|photo-1616486338812-3dadae4b4ace.jpg|photo-1496181133206-80ce9b88a853.jpg|photo-1501004318641-b39e6451bec6.jpg|photo-1544816155-12df9643f363.jpg' | split: '|' %}{% for category_name in category_names %}<a class="category" href="{{ routes.all_products_collection_url }}"><img src="{{ category_images[forloop.index0] | asset_url }}" alt="{{ category_name | escape }}" loading="lazy" width="180" height="180"><strong>{{ category_name | escape }}</strong><small>Xem sản phẩm</small></a>{% endfor %}{% endif %}</div></section>
    {% assign flash_collection = section.settings.flash_collection %}{% if flash_collection != blank %}<section class="flash" id="mini-flash-{{ section.id }}"><div class="flash-head"><h2>♨ {{ section.settings.flash_heading | escape }}</h2><span class="timer">{{ section.settings.flash_note | escape }}</span><a class="more-link" href="{{ flash_collection.url }}">Xem tất cả deal hot ›</a></div><div class="product-row">{% for product in flash_collection.products limit: 5 %}{% render 'minishop-product-card', product: product, featured: false %}{% else %}<p class="empty-state">Chưa có sản phẩm trong bộ sưu tập này.</p>{% endfor %}</div></section>{% endif %}
    {% assign featured_collection = section.settings.featured_collection %}{% if featured_collection != blank %}<section class="section" id="mini-featured-{{ section.id }}"><div class="section-head"><h2>{{ section.settings.featured_heading | escape }}</h2><div class="tabs"><button class="tab active" type="button" data-sort="newest">Mới cập nhật</button><button class="tab" type="button" data-sort="price-ascending">Giá thấp trước</button><button class="tab" type="button" data-sort="price-descending">Giá cao trước</button></div></div><div class="featured-grid">{% for product in featured_collection.products limit: section.settings.products_to_show %}{% render 'minishop-product-card', product: product, featured: true %}{% else %}<p class="empty-state">Chưa có sản phẩm nổi bật.</p>{% endfor %}</div><div class="load"><a href="{{ featured_collection.url }}">Xem thêm sản phẩm nổi bật ›</a></div></section>{% endif %}
  </main>
  <footer class="site-footer"><div class="footer-content wrap"><section><h2>Về {{ shop.name | escape }}</h2><a href="{{ routes.root_url }}">Giới thiệu công ty</a><a href="{{ routes.collections_url }}">Hệ thống sản phẩm</a><a href="{{ pages['contact'].url | default: routes.root_url }}">Liên hệ</a></section><section><h2>Hỗ trợ khách hàng</h2><a href="{{ pages['chinh-sach-doi-tra'].url | default: routes.root_url }}">Chính sách đổi trả 30 ngày</a><a href="{{ pages['huong-dan-mua-hang'].url | default: routes.root_url }}">Hướng dẫn mua hàng</a><a href="{{ pages['chinh-sach-giao-hang'].url | default: routes.root_url }}">Chính sách giao hàng</a><a href="{{ routes.account_url }}">Tra cứu đơn hàng</a></section><section><h2>Tổng đài hỗ trợ</h2><p><strong>Mua hàng:</strong> <a href="tel:{{ section.settings.phone_link | escape }}">{{ section.settings.hotline | escape }}</a></p><p><strong>Email:</strong> {{ section.settings.email | escape }}</p></section><section><h2>Phương thức thanh toán</h2><div class="payment-methods"><span>COD</span><span>Chuyển khoản</span><span>ATM / Visa</span></div><p class="trade-mark">{{ section.settings.footer_badge | escape }}</p></section></div><div class="copyright">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</div></footer>
</div>
{{ 'minishop-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'minishop-home.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "MiniShop homepage",
  "settings": [
    {"type":"text","id":"brand_text","label":"Tên thương hiệu","default":"MiniShop"},
    {"type":"text","id":"hotline","label":"Hotline","default":"1800 6868 (Miễn phí)"},
    {"type":"text","id":"phone_link","label":"Số điện thoại liên kết","default":"18006868"},
    {"type":"text","id":"delivery_note","label":"Thông tin giao hàng","default":"Giao hàng nhanh 2h toàn quốc"},
    {"type":"text","id":"store_note","label":"Thông tin cửa hàng","default":"Hệ thống 120 cửa hàng"},
    {"type":"text","id":"email","label":"Email hỗ trợ","default":"cskh@minishop.vn"},
    {"type":"text","id":"benefit_1_title","label":"Lợi ích 1","default":"100% Chính hãng"}, {"type":"text","id":"benefit_1_text","label":"Mô tả lợi ích 1","default":"Cam kết nguồn gốc xuất xứ"},
    {"type":"text","id":"benefit_2_title","label":"Lợi ích 2","default":"Đổi trả 30 ngày"}, {"type":"text","id":"benefit_2_text","label":"Mô tả lợi ích 2","default":"Miễn phí thủ tục tại chỗ"},
    {"type":"text","id":"benefit_3_title","label":"Lợi ích 3","default":"Giao 2H siêu tốc"}, {"type":"text","id":"benefit_3_text","label":"Mô tả lợi ích 3","default":"Áp dụng nội thành TP.HCM & HN"},
    {"type":"text","id":"benefit_4_title","label":"Lợi ích 4","default":"Hỗ trợ 24/7"}, {"type":"text","id":"benefit_4_text","label":"Mô tả lợi ích 4","default":"Tổng đài miễn cước"},
    {"type":"text","id":"categories_heading","label":"Tiêu đề danh mục","default":"Danh mục nổi bật"},
    {"type":"collection_list","id":"categories","label":"Danh mục nổi bật","limit":6},
    {"type":"text","id":"flash_heading","label":"Tiêu đề Flash Sale","default":"FLASH SALE GIỜ VÀNG"},
    {"type":"text","id":"flash_note","label":"Thông tin Flash Sale","default":"Ưu đãi có hạn mỗi ngày"},
    {"type":"collection","id":"flash_collection","label":"Bộ sưu tập Flash Sale"},
    {"type":"text","id":"featured_heading","label":"Tiêu đề sản phẩm","default":"SẢN PHẨM NỔI BẬT"},
    {"type":"collection","id":"featured_collection","label":"Bộ sưu tập sản phẩm nổi bật"},
    {"type":"range","id":"products_to_show","label":"Số sản phẩm nổi bật","min":4,"max":16,"step":1,"default":10},
    {"type":"text","id":"footer_badge","label":"Nhãn chân trang","default":"Đã thông báo Bộ Công Thương"}
  ],
  "blocks": [
    {"type":"slide","name":"Ảnh banner","settings":[{"type":"image_picker","id":"image","label":"Ảnh"},{"type":"text","id":"caption","label":"Chú thích"},{"type":"url","id":"link","label":"Liên kết"}]},
    {"type":"promo","name":"Ô khuyến mãi","settings":[{"type":"image_picker","id":"image","label":"Ảnh nền"},{"type":"text","id":"label","label":"Nhãn","default":"Ưu đãi nổi bật"},{"type":"text","id":"heading","label":"Tiêu đề","default":"Khám phá ưu đãi mới"},{"type":"text","id":"offer","label":"Thông tin ưu đãi","default":"Ưu đãi mỗi ngày"},{"type":"text","id":"link_label","label":"Nhãn liên kết","default":"Khám phá ngay"},{"type":"url","id":"link","label":"Liên kết"}]}
  ],
  "max_blocks": 12,
  "presets": [{"name":"MiniShop homepage","blocks":[{"type":"slide"},{"type":"slide"},{"type":"promo","settings":{"label":"Cà phê thượng hạng","heading":"Ưu đãi cà phê nguyên chất","offer":"MUA 2 TẶNG 1"}},{"type":"promo","settings":{"label":"Nhà cửa & đời sống","heading":"Đồ gia dụng thông minh","offer":"VOUCHER 50.000₫"}}]}]
}
{% endschema %}
